// Kanban Board - Prisma schema
// https://pris.ly/d/prisma-schema
//
// The shape of the app: a Project owns Boards, a Board owns Columns and
// Tasks, and every mutation is recorded in an append-only Activity log.
//
// Two deliberate decisions are worth reading before you edit this file:
//
// 1. A Task carries BOTH `boardId` and `columnId`. The column is the real
//    foreign key - a task lives in exactly one column at a time - but the
//    board is denormalised onto the row so that loading a whole board is one
//    indexed query instead of a join. Moving a task between columns is
//    therefore a single UPDATE of two columns, never a delete and recreate.
//
// 2. A Column cannot be deleted out from under its tasks. The relation from
//    Task to Column is ON DELETE NO ACTION, which PostgreSQL checks at the
//    end of the statement rather than immediately. That gives us both
//    behaviours we need: deleting a column that still holds tasks fails, and
//    deleting a whole board (which cascades to columns AND tasks) still
//    succeeds, because by the time the check runs the tasks are already gone.
//
//    ON DELETE RESTRICT would have been the obvious choice and would have
//    broken board deletion. See the comment on Task.column.

generator client {
	provider = "prisma-client"
	output   = "../src/generated/prisma"
}

datasource db {
	provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Membership role. Higher rank wins; see ROLE_RANK in @kanban/config.
enum Role {
	OWNER
	EDITOR
	VIEWER
}

/// Task priority. Also sortable - see PRIORITY_RANK in @kanban/config.
enum Priority {
	LOW
	MEDIUM
	HIGH
	URGENT
}

/// Every event recorded in the Activity log.
enum ActivityAction {
	PROJECT_CREATED
	BOARD_CREATED
	BOARD_RENAMED
	BOARD_ARCHIVED
	COLUMN_CREATED
	COLUMN_RENAMED
	COLUMN_MOVED
	COLUMN_DELETED
	TASK_CREATED
	TASK_UPDATED
	TASK_MOVED
	TASK_DELETED
	TASK_RESTORED
	TASK_ASSIGNED
	TASK_UNASSIGNED
	TASK_PRIORITY_CHANGED
	TASK_DUE_CHANGED
	TASK_COMPLETED
	TASK_REOPENED
	SUBTASK_ADDED
	SUBTASK_COMPLETED
	MEMBER_ADDED
	MEMBER_ROLE_CHANGED
	MEMBER_REMOVED
	AI_SUGGESTED_SUBTASKS
	AI_DRAFTED_DESCRIPTION
	AI_CATEGORISED_TASK
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
	id          String   @id @default(cuid())
	email       String   @unique
	name        String
	avatarColor String   @default("#6366f1")
	/// Platform administrators bypass membership checks entirely.
	isAdmin     Boolean  @default(false)
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	ownedProjects      Project[]       @relation("ProjectOwner")
	projectMemberships ProjectMember[]
	boardMemberships   BoardMember[]
	assignedTasks      Task[]          @relation("TaskAssignee")
	reportedTasks      Task[]          @relation("TaskReporter")
	activities         Activity[]

	@@index([email])
}

/// Membership of a project. Inherited by every board in the project unless a
/// BoardMember row overrides it for that board.
model ProjectMember {
	projectId String
	userId    String
	role      Role      @default(VIEWER)
	createdAt DateTime  @default(now())
	updatedAt DateTime  @updatedAt

	project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
	user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@id([projectId, userId])
	@@index([userId])
}

/// A per-board role override. A null role means "inherit from the project".
/// An override may lower a role as well as raise it.
model BoardMember {
	boardId   String
	userId    String
	role      Role?
	createdAt DateTime  @default(now())
	updatedAt DateTime  @updatedAt

	board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
	user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@id([boardId, userId])
	@@index([userId])
}

// ---------------------------------------------------------------------------
// Structure
// ---------------------------------------------------------------------------

model Project {
	id          String   @id @default(cuid())
	name        String
	slug        String   @unique
	/// Short uppercase prefix used when building task references, e.g. "ATL".
	key         String
	description String?
	ownerId     String
	isArchived  Boolean  @default(false)
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	owner   User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
	boards  Board[]
	members ProjectMember[]

	@@index([ownerId])
}

model Board {
	id          String   @id @default(cuid())
	projectId   String
	name        String
	description String?
	sortOrder   Int      @default(0)
	isArchived  Boolean  @default(false)
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
	columns    Column[]
	tasks      Task[]
	labels     Label[]
	members    BoardMember[]
	activities Activity[]

	/// Board names are unique within a project. This is also the natural key
	/// the seed upserts on.
	@@unique([projectId, name])
	@@index([projectId, sortOrder])
}

model Column {
	id        String   @id @default(cuid())
	boardId   String
	name      String
	color     String?
	/// Position of the column on the board, left to right.
	sortOrder Int      @default(0)
	/// Optional work-in-progress limit. The board shows a warning when the
	/// number of tasks in the column exceeds it.
	wipLimit  Int?
	/// Marks the column that completed work lands in.
	isDone    Boolean  @default(false)
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
	tasks Task[]

	/// Column names are unique within a board. This is also the natural key
	/// the seed upserts on.
	@@unique([boardId, name])
	@@index([boardId, sortOrder])
}

// ---------------------------------------------------------------------------
// Work
// ---------------------------------------------------------------------------

model Task {
	id          String    @id @default(cuid())
	boardId     String
	columnId    String
	/// Self relation for subtasks. A subtask is an ordinary task with a
	/// parent, so it inherits every field, filter and drag behaviour.
	parentId    String?
	title       String
	description String?
	priority    Priority  @default(MEDIUM)
	dueDate     DateTime?
	/// Fractional ordering within a column. New tasks are inserted at the
	/// midpoint between their neighbours, so a drag is a single row update.
	/// The column is renormalised when the gap between two tasks drops below
	/// 1e-6. See the ordering notes in packages/db/src/queries.js.
	position    Float     @default(1024)
	assigneeId  String?
	reporterId  String?
	completedAt DateTime?
	/// Soft delete. Archived tasks stay out of the board but keep their
	/// history and can be restored.
	isArchived  Boolean   @default(false)
	createdAt   DateTime  @default(now())
	updatedAt   DateTime  @updatedAt

	board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
	column   Column   @relation(fields: [columnId], references: [id], onDelete: NoAction)
	assignee User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
	reporter User?    @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
	parent   Task?    @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
	subtasks Task[]   @relation("Subtasks")
	labels   TaskLabel[]

	/// The primary read path: every task in a column, in order.
	@@index([columnId, position])
	/// The secondary read path: every task on a board.
	@@index([boardId])
	@@index([assigneeId])
	@@index([dueDate])
	@@index([parentId])
}

model Label {
	id        String   @id @default(cuid())
	boardId   String
	name      String
	color     String
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	board Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
	tasks TaskLabel[]

	/// Label names are unique within a board. This is also the natural key
	/// the seed upserts on.
	@@unique([boardId, name])
	@@index([boardId])
}

model TaskLabel {
	taskId    String
	labelId   String
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
	label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

	@@id([taskId, labelId])
	@@index([labelId])
}

// ---------------------------------------------------------------------------
// History
// ---------------------------------------------------------------------------

/// Append-only log of everything that happened on a board. Written in the
/// same transaction as the change it describes, so the history can never
/// drift from the state. This table is also the source of the live updates
/// in M7 - one write, two readers.
model Activity {
	id         String         @id @default(cuid())
	boardId    String
	actorId    String?
	action     ActivityAction
	/// "task", "column", "board" - what the action happened to.
	entityType String
	entityId   String
	/// The diff, e.g. { fromColumnId, toColumnId, fromAssigneeId }.
	metadata   Json           @default("{}")
	createdAt  DateTime       @default(now())
	updatedAt  DateTime       @updatedAt

	board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
	actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

	/// The timeline read path: newest first, for one board.
	@@index([boardId, createdAt])
	@@index([actorId])
	@@index([entityType, entityId])
}
