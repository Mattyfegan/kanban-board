# ---------------------------------------------------------------------------
# Kanban Board - environment configuration
#
# Copy to `.env` and adjust. `.env` is gitignored; this file is the template.
#   cp .env.example .env
#
# Every variable is validated at startup by packages/config/src/environment.js.
# A missing or malformed value fails fast with a readable message rather than
# surfacing as an undefined deep inside a query.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Port 5434 avoids the Postgres instances already running for the sibling
# projects in this workspace (expense-tracker uses 5432, booking-system 5433).
# The docker compose service below is published on the same port.
DATABASE_URL="postgresql://kanban:kanban@localhost:5434/kanban_board?schema=public"

# Individual variables, used when DATABASE_URL is not set.
POSTGRES_HOST="localhost"
POSTGRES_PORT="5434"
POSTGRES_USER="kanban"
POSTGRES_PASSWORD="kanban"
POSTGRES_DB="kanban_board"

# Connection pool tuning (optional).
# DB_POOL_MAX="5"
# DB_POOL_IDLE_TIMEOUT="30000"
# DB_POOL_CONNECTION_TIMEOUT="5000"

# --- Application -----------------------------------------------------------
# Base URL of the app, used for absolute links.
APP_URL="http://localhost:3000"

# --- AI provider (optional) ------------------------------------------------
# The AI surface is built and wired, but ships disabled: `null` is the default
# provider and every AI action returns a clean "not configured" result.
#
# To switch a real model on later, set AI_PROVIDER and the matching values -
# no code changes are required outside packages/ai/src/providers/.
#
#   AI_PROVIDER="null"                                  # default, disabled
#   AI_PROVIDER="openai"        + AI_API_KEY, AI_MODEL
#   AI_PROVIDER="anthropic"     + AI_API_KEY, AI_MODEL
#   AI_PROVIDER="openai-compatible" + AI_API_KEY, AI_MODEL, AI_BASE_URL
#                                                  (Ollama: http://localhost:11434/v1)
AI_PROVIDER="null"
# AI_API_KEY=""
# AI_BASE_URL=""
# AI_MODEL=""
